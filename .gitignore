# Dependencies
node_modules/

# Build output
dist/
build/

# Environment files
.env*
!.env.example

# Logs
*.log
*.log.err

# OS files
.DS_Store

# MongoDB local data
.mongo-data/

# IDE metadata
.kilo/

# Vite cache
.vite/

# Coverage
coverage/

# Playwright E2E output (traces, screenshots, the JSON report). Unlike the
# responsive-audit snapshots — which ARE committed evidence — these are large
# binaries reproduced by running the suite, so they stay out of the repo.
frontend/e2e/.artifacts/
test-results/
playwright-report/

# Local-dev upload fallback (backend/controllers/uploadController.js writes here
# when ImageKit is unconfigured) — runtime media, never source
frontend/public/uploads/

# 3D Studio PRIVATE reference media (backend/services/referenceAssetStorage.js,
# overridable with REFERENCE_MEDIA_DIR). Originals, cutouts and neutral previews
# of unreviewed product photographs are runtime data and must never be committed.
backend/reference-media/

# Freebuff runtime logs
.freebuff/*.log
.freebuff/*.log.err
# Responsive audit runs — disposable reports generated by frontend/scripts/responsive-audit/run.mjs
frontend/scripts/responsive-audit/results

# The E2E owner fixture's per-run password. frontend/e2e/stack.mjs writes it so
# the suite can sign in as the platform owner without a credential ever living
# in source; it is a disposable-database value and must never be committed.
frontend/e2e/.owner-credentials.json

# Phase 3 E2E — the PRIVATE 3D media root the E2E stack writes its approved
# fixture model into (frontend/e2e/stack.mjs). Runtime media, never source.
frontend/e2e/.media-3d/
# Phase 6 E2E — the PRIVATE reference-media root the E2E stack writes its
# deterministic cutouts into (frontend/e2e/stack.mjs). Runtime media, never source.
frontend/e2e/.media-references/

# Pre-merge audit scratch space (logs, probe scripts, patch backups). Never part
# of a release; kept out of the repository so a diff cannot carry audit noise.
/audit/

# Release-evidence scratch and screenshots (visual captures, calibration logs).
# Like /audit/ above these are reproduction artifacts, not source: they are kept
# on disk as evidence but must never enter a commit, so a broad `git add` cannot
# carry them into a release.
/.scratch/
/screenshots/

# Local logical backups and monitoring state (scripts/backup.mjs). These are
# database payloads, encryption keys are never written here, and a repository is
# not a backup destination — the default root is outside the checkout, this
# ignore only protects an explicit in-tree BACKUP_ROOT.
backend/backups/
backend/.backups/
backup-state/

# Private runtime media. The 3D root used to be documented as `backend/3d-media`
# while the code actually wrote `backend/backend/uploads/3d-media` (a CWD bug).
# It is now `<backend>/uploads/3d-media` — so the REAL default is ignored, not a
# path the code no longer uses. Reference media has its own root below.
backend/uploads/
backend/3d-media/

# Phase 4 3D worker (tools/3d-worker) is committed as SOURCE only — never
# bytecode or a Python environment. The venv, the TripoSR checkout and the model
# weights all live outside the repository (~/flora-3d, ~/.cache/huggingface), and
# generated models are already covered by /audit/ above.
__pycache__/
*.py[cod]
.venv/
venv/
worker-diagnostics/
