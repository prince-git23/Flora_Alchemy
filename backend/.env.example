# ── Flora Alchemy API — environment template ─────────────────────────────
# Copy to backend/.env and fill in real values. Never commit .env.

# ── Environment matrix (Phase 20.6) ───────────────────────────────────────
# Every write path (server boot seeding, `npm run seed`, the inventory
# backfill) runs through backend/utils/environmentGuard.js, which derives the
# effective database name from MONGO_URI and FAILS CLOSED unless it is
# unmistakably disposable. Do not bypass it.
#
#   Environment | Effective database                | Source
#   ------------|-----------------------------------|----------------------------------
#   Development | flora_alchemy (local mongod)      | this file (default below)
#   Test        | Flora-Alchemy-Test-<Suite>        | scripts/lib/testServer.mjs (auto)
#   QA          | Flora-Alchemy-Test-QA-*           | QA env MONGO_URI
#   Production  | Flora-Alchemy                     | hosting dashboard ONLY
#
# Rules:
#   · Database names containing test/qa/dev/smoke/sandbox (or a localhost
#     host) are treated as disposable and may be seeded/cleaned.
#   · Any other database refuses destructive/fixture writes when
#     NODE_ENV=production, when listed in PRODUCTION_DB_NAMES, or without an
#     explicit one-off confirmation (CONFIRM_DATABASE_UNSAFE_OPERATION=<db>).
#   · Demo fixture credentials (seed.js) are only ever created in disposable
#     databases — never in production.
#   · Set PRODUCTION_DB_NAMES to a comma-separated list of database names
#     that must NEVER receive destructive writes, e.g.:
# PRODUCTION_DB_NAMES=Flora-Alchemy

# API server
PORT=4000
NODE_ENV=development

# MongoDB connection (development default — a LOCAL database)
MONGO_URI=mongodb://127.0.0.1:27017/flora_alchemy

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed browser origins.
# EXACT-ORIGIN matching, never a wildcard. Entries are canonicalized to the form
# a browser sends (lower-case host, no trailing slash, no path), so
# `https://Store.Example.com/` and `https://store.example.com` are the same
# entry. An entry that cannot be canonicalized (no scheme, `*`,
# `https://*.example.com`, `file://…`) is DROPPED at boot with a warning — a
# wildcard can never be configured. The effective list is logged at startup as
# `[config] CORS allowlist (n) → …`; check that line first when the storefront
# gets `403 ORIGIN_NOT_ALLOWED`.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ── Staff portal URL (Phase 20.6.3) ──────────────────────────────────────
# Absolute origin used to build staff INVITATION links
# (<STAFF_PORTAL_URL>/admin/activate/<token>). Must be the origin staff
# actually reach — the production frontend origin in production, not the API
# origin. Falls back to CLIENT_URL, then http://localhost:3000.
STAFF_PORTAL_URL=http://localhost:3000

# ── Razorpay — TEST MODE ONLY (Phase 3E) ─────────────────────────────────
# Use only rzp_test_... keys. When these are absent the checkout keeps its
# frozen prototype behavior (paymentStatus 'Sample', no real charge).
# RAZORPAY_KEY_ID=rzp_test_your_key_id
# RAZORPAY_KEY_SECRET=rzp_test_your_key_secret
# RAZORPAY_BASE_URL=https://api.razorpay.com
# RAZORPAY_WEBHOOK_SECRET=optional-test-webhook-secret

# ── Security (Phase 15) ─────────────────────────────────────────────────
# NODE_ENV=production enables strict rate limits and must be set in prod.
# NODE_ENV=production

# Comma-separated CORS allowlist. REQUIRED in production — the dev default
# only allows http://localhost:3000 and http://127.0.0.1:3000.
# CORS_ORIGIN=https://your-store.example,https://www.your-store.example

# Behind a reverse proxy (Nginx/Render/Railway), set true so rate limiting
# sees real client IPs from X-Forwarded-For.
# TRUST_PROXY=false

# Rate limits (requests per 15-minute window; defaults shown)
# RATE_LIMIT_LOGIN_FAILED_MAX=10    # prod: 10 failed logins/IP, dev: 50
# RATE_LIMIT_REGISTER_MAX=20       # prod: 20, dev: 150
# RATE_LIMIT_PAYMENT_MAX=150
# RATE_LIMIT_UPLOAD_MAX=40
# RATE_LIMIT_NOTIFICATION_MAX=300
# RATE_LIMIT_WEBHOOK_MAX=300
# RATE_LIMIT_API_WRITE_MAX=600

# ── ImageKit — product image hosting (Phase 14) ─────────────────────────
# When ALL THREE are set, product image uploads go to ImageKit's CDN.
# When absent, uploads persist locally to frontend/public/uploads (real
# files, single-instance). Never put the private key in frontend code.
# IMAGEKIT_PRIVATE_KEY=your_private_key
# IMAGEKIT_PUBLIC_KEY=your_public_key
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
# IMAGEKIT_FOLDER=/flora-alchemy/products

# ── 3D Studio — prepared reference images ───────────────────────────────
# Phase 1 uploads product photos, removes their background and stores the
# original + cutout + neutral preview as PRIVATE files served only through
# /api/references (never the public uploads folder, never the CDN).
#
# The built-in deterministic engine needs nothing configured — it uses sharp.
# The optional ML engine (rembg) needs a local Python install; see
# docs/IMAGE_STUDIO.md for the setup and the MODEL LICENCE table. A model whose
# weights are not cleared for commercial use (notably rembg's default
# `bria-rmbg`) is REFUSED in code, even if set here.
# REFERENCE_MEDIA_DIR=/absolute/path/to/reference-media   # default: backend/reference-media
# BGREMOVE_PROVIDER=auto        # auto | deterministic | rembg
# BGREMOVE_MODEL=u2net          # u2net | u2netp | silueta | birefnet-general | birefnet-general-lite
# BGREMOVE_PYTHON=C:/path/to/tools/bgremove/.venv/Scripts/python.exe
# BGREMOVE_PROBE=0             # skip the cached rembg probe
# BGREMOVE_FALLBACK=0          # forbid the recorded fallback to the built-in engine
# BGREMOVE_DECONTAMINATE=1     # strip background colour fringing from soft edges
# BGREMOVE_TIMEOUT_MS=180000
# BGREMOVE_ALLOW_UNVERIFIED_MODEL=1   # only with permission for that model's weights
# BGREMOVE_DEBUG=1

# ── 3D Studio — model generation (Phase 2) ──────────────────────────────
# Turns an ACCEPTED prepared reference set into a GLB candidate that an
# administrator reviews and approves. The generated model lives in its OWN
# private root and is served only through the authenticated /api/3d routes.
#
# GENERATION IS OFF BY DEFAULT, and that is the intended state. There is no
# local provider compiled into this build, and the hosted adapter is metered,
# so nothing here can spend money until an operator opts in on purpose.
#
# To enable the hosted adapter you must set BOTH variables:
#
#   3D_PROVIDER=meshy      # explicit opt-in. Anything else = generation disabled.
#   MESHY_API_KEY=...      # server-side only; never returned by any endpoint.
#
# A key WITHOUT 3D_PROVIDER=meshy is inert, and a provider without a key is a
# refusal — never a silent fallback to a paid call. See docs/IMAGE_STUDIO.md.
#
# The preferred production shape is a LOCAL provider on a GPU host (no recurring
# per-generation cost); this build ships no local engine, so the default is a
# readable "unavailable" with the reason shown in the studio.
# 3D_PROVIDER=meshy
# MESHY_API_KEY=
# MESHY_MODEL=meshy-7-1
# MESHY_API_BASE_URL=https://api.meshy.ai/v1
#
# Private media root for generated GLBs and their thumbnails. Must be a
# persistent volume for a multi-instance deployment.
# THREE_MEDIA_ROOT=/absolute/path/to/3d-media   # default: backend/uploads/3d-media
# THREE_STUDIO_DEBUG=1   # log a job's failure reason to the server console

# ── 3D Studio — the quality gate (Phase 5) ───────────────────────────────
# Every generated candidate is MEASURED before it can be approved: the stored
# mesh is projected onto documented orthographic views and compared with the
# accepted cutout (IoU, aspect error, coverage, centroid, contour distance),
# and its structure is checked (counts, degenerate geometry, bounds, materials).
# PASS approves as before; REVIEW needs an explicit acknowledgement with a note;
# BLOCKED refuses normal approval unless an administrator overrides with a
# reason, which is recorded together with the verdict it overrode.
#
# The bands below are PROVISIONAL — set conservatively against ONE genuine
# generated model plus synthetic fixtures, so the PASS band is deliberately hard
# to reach and borderline results stay human decisions. passIou must exceed
# blockIou, otherwise the assessment refuses to run (QUALITY_THRESHOLDS_INVALID).
# See docs/IMAGE_STUDIO.md — Phase 5 for every metric definition.
# THREE_QUALITY_PASS_IOU=0.75
# THREE_QUALITY_BLOCK_IOU=0.35
# THREE_QUALITY_PASS_ASPECT_ERROR=0.25
# THREE_QUALITY_BLOCK_ASPECT_ERROR=1.0
# THREE_QUALITY_MIN_VIEW_MARGIN=0.05    # a narrower win means the view is a guess -> REVIEW
# THREE_QUALITY_REQUIRE_MATERIALS=1     # stricter policy: texture maps required, not only warned

# ── Owner bootstrap (`npm run provision-admin`, Phase 20.6.1 / 21.1) ──────
# These are NOT read by the server — they are consumed only by the one-off
# provisioning command. Prefer the hidden interactive prompt; set the env vars
# only for non-interactive runs. Never commit real values.
#   PROVISION_ADMIN_EMAIL / OWNER_EMAIL             the owner's email
#   PROVISION_ADMIN_PASSWORD / OWNER_PASSWORD       min 12 chars, never printed
#   PROVISION_ADMIN_NAME / OWNER_NAME               optional display name
#   PROVISION_ADMIN_RECOVERY=I_UNDERSTAND_AN_ADMIN_EXISTS   only to add another
#       admin once one already exists (Flora Alchemy keeps exactly ONE owner).
#   CONFIRM_DATABASE_UNSAFE_OPERATION=<exact db>  +  \
#   PROVISION_ADMIN_CONFIRM=CREATE_PRODUCTION_ADMIN
#       both required to write a privileged account into a non-disposable db.
# OWNER_EMAIL=
# OWNER_PASSWORD=

# Seed demo fixtures (handler + customer accounts) on boot when the database
# is empty. Fixtures are marked isFixture. Keep true for local development;
# MUST be false in production (boot refuses to start otherwise), and seeding
# is additionally blocked against any non-disposable database (Phase 20.6).
# The demo handler password is published in seed.js — an active copy of that
# account in production is a credential backdoor, so fixture accounts are
# never created there.
SEED_ON_START=true
