{
  "name": "flora-alchemy-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Flora Alchemy API — Express + MongoDB backend (auth, catalog, orders, inventory, analytics, settings)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node seed/seed.js",
    "provision-admin": "node scripts/provision-admin.mjs",
    "test:api": "node scripts/api-smoke.mjs",
    "test:provisioning": "node scripts/provisioning-smoke.mjs",
    "test:payment": "node scripts/payment-smoke.mjs",
    "test:conversation": "node scripts/conversation-smoke.mjs",
    "test:pricing": "node scripts/custom-gift-pricing-test.mjs",
    "test:integration": "node scripts/integration-smoke.mjs",
    "test:security": "node scripts/security-smoke.mjs",
    "test:applications": "node scripts/application-flow-smoke.mjs",
    "test:razorpay-real": "node scripts/razorpay-real-smoke.mjs",
    "test:all": "node scripts/run-all.mjs",
    "test": "npm run test:all"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "4.22.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^2.3.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
